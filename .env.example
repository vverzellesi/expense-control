# Database (Neon PostgreSQL)
# Get your connection string from https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
AUTH_TRUST_HOST=true

# Resend (Email)
# Get your API key from https://resend.com
RESEND_API_KEY="re_xxxxxxxxxx"

# GitHub Integration (Bug Reports)
# Classic PAT with scopes: 'repo' (Issues + Contents API) and 'project' (Project Board v2)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=""

# PDF encryption key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PDF_ENCRYPTION_KEY=

# Google Gemini API (opcional — sem ela o AI parser desliga e cai no fallback regex)
GEMINI_API_KEY=

# Quota mensal de calls de IA por usuário (default 5)
AI_MONTHLY_QUOTA=5

# Pluggy (Open Finance, conector MeuPluggy) — só no servidor, nunca em NEXT_PUBLIC_*
# Credenciais em https://dashboard.pluggy.ai; o item é a conexão autorizada no MeuPluggy
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_ID=

# Sincronização Pluggy (desligada por padrão: sem "true" o cron responde 503 e o webhook ignora tudo)
PLUGGY_SYNC_ENABLED=
# id do usuário dono da integração (único usuário cujos vínculos são sincronizados)
PLUGGY_OWNER_USER_ID=
# Segredo de assinatura do webhook (/webhooks/pluggy), copiado do painel da Pluggy.
# Durante a troca, aceite os dois separados por vírgula: "<novo>,<antigo>"
PLUGGY_WEBHOOK_SECRET=
# Segredo do Vercel Cron (Authorization: Bearer). Gere com: openssl rand -hex 32
CRON_SECRET=
